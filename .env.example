# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
ALLOWED_CHANNEL_ID=

# Command Prefix (optional)
# Add a prefix to all command names. Leave empty for no prefix.
# Example: "mc" will make commands like /mc-whitelist-add instead of /whitelist-add
COMMAND_PREFIX=

# Discord Command Categories (set to true/false to enable/disable)
# All categories are enabled by default
ENABLE_WHITELIST_COMMANDS=true
ENABLE_PLAYER_COMMANDS=true
ENABLE_SERVER_COMMANDS=true

# Role-Based Access Control (RBAC)
# Set to true to enable role-based permissions
ENABLE_RBAC=false
# Allow administrators to bypass role checks
RBAC_ADMIN_BYPASS=true

# Role names or IDs allowed to use commands (comma-separated)
# Leave empty to allow all users when RBAC is disabled
# Use "@everyone" to explicitly allow all users
# Examples: "Admin,Moderator" or "123456789,987654321"
WHITELIST_ROLES=
PLAYER_ROLES=
SERVER_ROLES=

# Minecraft RCON Configuration
RCON_HOST=minecraft
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password_here

# Optional: ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production
